{
	"name": "jashjacob/credits-shortcode",
	"description": "Easy shortcode and Gutenberg block to insert Source and Via Link inside posts in WordPress.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Jash Jacob",
			"homepage": "https://jashjacob.com"
		}
	],
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6"
	},
	"scripts": {
		"test": "phpunit",
		"test:integration": "phpunit -c phpunit-integration.xml.dist",
		"ci": "bash scripts/ci-local.sh",
		"ci:integration": "bash scripts/ci-local.sh --integration",
		"ci:e2e": "bash scripts/ci-local.sh --e2e",
		"ci:full": "bash scripts/ci-local.sh --full",
		"setup-hooks": "git config core.hooksPath scripts/git-hooks"
	},
	"config": {
		"platform": {
			"php": "7.4.0"
		}
	}
}
